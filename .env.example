# Everything below is optional: the app works without any configuration.

# Server-side only, never exposed to the browser. Powers the "Explain with AI"
# button (app/api/explain/route.ts). Get a key at https://console.groq.com/keys
GROQ_API_KEY=

# Optional: override the model, and the limits (requests per minute)
# GROQ_MODEL=openai/gpt-oss-120b
# EXPLAIN_RATE_PER_MIN=6
# EXPLAIN_GLOBAL_PER_MIN=60

# Number of reverse proxies in front of the app (Vercel: 1), so each visitor gets
# their own rate limit. Leave unset when running locally.
# TRUSTED_PROXY_HOPS=1

# The site's public address, only if it is served from more than one host
# ALLOWED_ORIGIN=https://geoverse.example
